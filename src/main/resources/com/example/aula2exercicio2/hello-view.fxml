<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="724.0" prefWidth="616.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.aula2exercicio2.HelloController">
  <padding>
    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
  </padding>
   <children>
      <TextField fx:id="idNome" prefHeight="25.0" prefWidth="213.0" promptText="Nome do cliente" />
      <ComboBox fx:id="idServico" prefHeight="25.0" prefWidth="258.0" promptText="Tipo de serviço" />
      <Label text="Quantidade de horas" />
      <Spinner fx:id="idQtdHoras" prefHeight="25.0" prefWidth="248.0" />
      <Label layoutX="262.0" layoutY="239.0" text="Valor cobrado por hora" />
      <Spinner fx:id="idValorHora" prefHeight="25.0" prefWidth="248.0" />
      <Label layoutX="256.0" layoutY="331.0" text="Percentual de desconto" />
      <Spinner fx:id="idDesconto" layoutX="53.0" layoutY="456.0" prefHeight="25.0" prefWidth="244.0" />
      <TextField fx:id="idDescricao" promptText="Descrição do serviço" />
      <Button fx:id="idCalcular" mnemonicParsing="false" onAction="#CalcularOrcamento" text="Calcular orçamento" />
      <TextArea fx:id="idResultado" prefHeight="200.0" prefWidth="200.0" />
   </children>
</VBox>
